<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build:  dotnet build -c Release -p:SpheresDir="C:\Games\Spheres"
    SpheresDir is the folder containing Spheres.exe (and Spheres_Data). If you are working inside the Spheres
    Unity project, Spheres.dll from Library/ScriptAssemblies is used automatically.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ExampleCardMod</AssemblyName>
    <RootNamespace>ExampleCardMod</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <SpheresDir Condition="'$(SpheresDir)' == ''">$(MSBuildThisFileDirectory)..\..\Builds\Windows</SpheresDir>
    <SpheresDll>$(SpheresDir)\Spheres_Data\Managed\Spheres.dll</SpheresDll>
    <SpheresDll Condition="!Exists('$(SpheresDll)') And Exists('$(MSBuildThisFileDirectory)..\..\Library\ScriptAssemblies\Spheres.dll')">$(MSBuildThisFileDirectory)..\..\Library\ScriptAssemblies\Spheres.dll</SpheresDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Spheres">
      <HintPath>$(SpheresDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Copy the plugin into the Thunderstore package folder after building. -->
  <Target Name="CopyToPackage" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)thunderstore\plugins" />
  </Target>
</Project>
